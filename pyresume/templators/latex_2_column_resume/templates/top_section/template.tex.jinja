% Header Section
\namesection{\VAR{name}}
{
    \large  % If you need to squeeze this to be smaller, set this to \normalsize or \small
    \urlstyle{same}
    \faEnvelope \hspace{0.1cm} \href{mailto:\VAR{email}}{\VAR{email}}\\
    \faPhone \hspace{0.1cm} \href{tel:\VAR{phone_iso}}{\VAR{phone_well_formed}} \\
    \faGithub \hspace{0.1cm} \href{\VAR{github_full}}{\VAR{github}}\\
    % In 2026-10-30, as a part of the fontawesome4 to fontawesome7 update, for whatever
    % reason, the linkedin icon gave a lot more horizontal space, so we compensate with
    % this manual negative kern
    \faLinkedinIn\kern-0.018em \hspace{0.1cm} \href{\VAR{linkedin_full}}{\VAR{linkedin}}\\
    \faGlobe \hspace{0.1cm} \href{\VAR{website_full}}{\VAR{website}}\\
    \faFlagUsa \hspace{0.1cm} US GC | \faCanadianMapleLeaf \hspace{0.1cm} Canadian
}
