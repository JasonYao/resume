#!/usr/bin/env bash

set -e # Fails on the first error

##
# Installs dependencies required for
# building/testing/deploying
##

source "bin/utils.sh"

# Ordered list of TeX Live repositories. Some CTAN mirrors have been seen serving
# certificates we don't trust, so every network step is retried against the others
tlnet_mirrors=(
    "https://ctan.math.illinois.edu/systems/texlive/tlnet"
    "https://mirror.ctan.org/systems/texlive/tlnet"
    "https://mirrors.mit.edu/CTAN/systems/texlive/tlnet"
    "https://mirrors.rit.edu/CTAN/systems/texlive/tlnet"
    "https://mirror.las.iastate.edu/CTAN/systems/texlive/tlnet"
    "https://mirrors.kernel.org/ctan/systems/texlive/tlnet"
)

function start() {
    install_texlive_package_manager

    # Debugging information
    install_imagemagick

    configure_imagemagick_policy
}

function configure_imagemagick_policy() {
    # Replaces the default (open) policy with a restrictive one that only
    # allows what the build needs: reading PDFs and writing PNGs.
    #
    # Policies are tied to the ImageMagick major version (the policy.xml
    # format and the available coders/delegates differ), so this only
    # supports ImageMagick 7, which is pinned in install_imagemagick
    local policy_dir="/etc/ImageMagick-7"
    if [ ! -d "$policy_dir" ]; then
        fail "Could not find the ImageMagick 7 configuration directory: $policy_dir"
    fi

    info "Writing ImageMagick security policy to $policy_dir/policy.xml"
    sudo tee "$policy_dir/policy.xml" > /dev/null <<'POLICY'
<policymap>
  <!-- Max pixel cache held in RAM. Once exceeded, pixels spill to disk.
       256MiB is plenty for a single-page resume render. A higher value
       (or unlimited) lets a hostile/corrupt file exhaust RAM and crash the
       runner (denial of service); a lower one only makes rendering slower
       by spilling to disk earlier. -->
  <policy domain="resource" name="memory" value="256MiB"/>
  <!-- Max memory-mapped file size for the pixel cache. Same trade-off as
       "memory": a larger value allows more address space to be consumed by
       a malicious image, a smaller value forces more disk-backed caching. -->
  <policy domain="resource" name="map" value="512MiB"/>
  <!-- Max width * height of an image held in memory. Larger images go to
       disk. 256MP is far above a 300 DPI letter page (~8.4MP); a much larger
       value would let decompression-bomb style images (tiny file, huge
       canvas) consume excessive resources. -->
  <policy domain="resource" name="area" value="256MP"/>
  <!-- Max disk space for the pixel cache; exceeding it aborts the operation.
       1GiB bounds the damage of a decompression bomb filling the runner's
       disk, while being well above what one rendered page needs. Unlimited
       would risk disk exhaustion. -->
  <policy domain="resource" name="disk" value="1GiB"/>
  <!-- Max image width. 32KP rejects absurdly wide images (a common
       resource-exhaustion vector) while allowing normal pages; raising it
       only widens the denial-of-service surface. -->
  <policy domain="resource" name="width" value="32KP"/>
  <!-- Max image height; same reasoning as width. -->
  <policy domain="resource" name="height" value="32KP"/>
  <!-- Max wall-clock seconds a single operation may run before it is
       aborted. 120s is generous for one page; unlimited would let a
       pathological input hang the CI job (denial of service). -->
  <policy domain="resource" name="time" value="120"/>
  <!-- Block the URL delegate so ImageMagick can't fetch remote resources.
       Allowing it would enable server-side request forgery style fetches
       (e.g. cloud metadata endpoints) from crafted input files. -->
  <policy domain="delegate" rights="none" pattern="URL"/>
  <!-- Block the HTTPS delegate; same SSRF/data-exfiltration reasoning as
       URL. Leaving it open lets a crafted file make outbound requests. -->
  <policy domain="delegate" rights="none" pattern="HTTPS"/>
  <!-- Block the HTTP delegate; same reasoning as URL, and additionally
       unencrypted. -->
  <policy domain="delegate" rights="none" pattern="HTTP"/>
  <!-- Block indirect reads (@file lists). Allowing them lets a crafted
       filename read arbitrary local files and leak their contents into the
       output (local file disclosure). -->
  <policy domain="path" rights="none" pattern="@*"/>
  <!-- Default-deny every coder (file format). Formats such as SVG, MVG, MSL,
       EPHEMERAL, and TEXT have historically had code-execution and
       file-read vulnerabilities (e.g. ImageTragick); denying by default
       means unlisted formats can never be processed, even by mistake. -->
  <policy domain="coder" rights="none" pattern="*"/>
  <!-- Allow only the formats the build uses: read the PDF produced by
       LaTeX and write the PNG preview. Adding more formats widens the
       attack surface; removing either breaks bin/build's magick call. -->
  <policy domain="coder" rights="read|write" pattern="{PDF,PNG}"/>
</policymap>
POLICY
}

function install_texlive_package_manager() {
    # We use TexLive since we need an easy way to
    # download specific packages easily on a *nix
    # system, as there's no equivalent to (and it'd
    # be prohibitively slow) MacTex's "everything included"
    # mentality
    bootstrap_texlive_package_manager
    update_texlive_package_manager
    verify_texlive_package_manager
    install_tex_dependency_packages

    # Keep no backups (not required, simply makes cache bigger)
    info "TexLive: Disabling backups"
    tlmgr option -- autobackup 0
    success "TexLive: Backups are disabled"

    update_cache_manifest
}

function bootstrap_texlive_package_manager() {
    # Modified from https://tex.stackexchange.com/questions/398830/how-to-build-my-latex-automatically-with-pdflatex-using-travis-ci/398831#398831

    # See if there is a cached version of TL available
    info "TexLive: Checking for cache version existence"
    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH
    if ! command -v texlua > /dev/null; then
        info "TexLive: Could not be found in cache, downloading and installing now"

        # Obtain TeX Live
        download_install_tl

        # Technically this'll only work until 2100 AD,
        # but I'm willing to take the risk that I'll be
        # dead by then or the services I'm using will
        # have changed/died out
        cd install-tl-20* || exit

        # Install a minimal system
        run_install_tl

        cd ..
        success "TexLive: Minimal texlive version was installed"
    else
        success "TexLive: Cached version found and installed"
    fi
}

function download_install_tl() {
    local mirror
    for mirror in "${tlnet_mirrors[@]}"; do
        info "TexLive: Downloading the installer from ${mirror}"
        if wget "${mirror}/install-tl-unx.tar.gz" && tar -xzf install-tl-unx.tar.gz; then
            return 0
        fi
        warn "TexLive: Failed to fetch the installer from ${mirror}, trying the next mirror"
        rm -f install-tl-unx.tar.gz
    done
    fail "TexLive: Failed to download the installer from every mirror"
}

function run_install_tl() {
    local mirror
    for mirror in "${tlnet_mirrors[@]}"; do
        if ./install-tl --profile=../bin/texlive.profile -repository "${mirror}"; then
            return 0
        fi
        warn "TexLive: Installer failed using ${mirror}, trying the next mirror"
    done
    fail "TexLive: Failed to run the installer against every mirror"
}

# Runs tlmgr with the given arguments, retrying against each mirror in turn
# until one succeeds
function tlmgr_with_mirrors() {
    local mirror
    for mirror in "${tlnet_mirrors[@]}"; do
        if tlmgr --repository "${mirror}" "$@"; then
            return 0
        fi
        warn "TexLive: 'tlmgr $*' failed using ${mirror}, trying the next mirror"
    done
    return 1
}

# Prints the names of the given packages that are not installed
function missing_tex_packages() {
    local installed pkg
    installed="$(tlmgr list --only-installed --data name)"
    for pkg in "$@"; do
        if ! grep -qxF "${pkg}" <<< "${installed}"; then
            echo "${pkg}"
        fi
    done
}

# Installs the given packages, retrying only the ones still missing against
# each mirror in turn, since individual packages can fail from a given mirror
# while the rest succeed. --reinstall is required to repair packages that
# install-tl left behind as "forcibly removed"
function tlmgr_install_missing_packages() {
    local mirror
    local -a missing
    for mirror in "${tlnet_mirrors[@]}"; do
        mapfile -t missing < <(missing_tex_packages "$@")
        if [ "${#missing[@]}" -eq 0 ]; then
            return 0
        fi
        info "TexLive: Installing ${#missing[@]} missing package(s) from ${mirror}: ${missing[*]}"
        if ! tlmgr --repository "${mirror}" install --reinstall "${missing[@]}"; then
            warn "TexLive: Some packages failed using ${mirror}, retrying only the missing ones on the next mirror"
        fi
    done

    mapfile -t missing < <(missing_tex_packages "$@")
    if [ "${#missing[@]}" -ne 0 ]; then
        warn "TexLive: Packages still missing after every mirror: ${missing[*]}"
        return 1
    fi
}

# Fails if any of the given files can't be found by TeX, catching broken installs early
function verify_tex_files() {
    local file ok=0
    for file in "$@"; do
        if [ -z "$(kpsewhich "${file}")" ]; then
            warn "TexLive: ${file} could not be found"
            ok=1
        fi
    done
    return "${ok}"
}

function update_texlive_package_manager() {
    # Update the TL install but add nothing new
    info "TexLive: Updating to the latest version"
    if ! tlmgr_with_mirrors update --self --all --no-auto-install; then
        fail "TexLive: Failed to update from every mirror"
    fi
    success "TexLive: Updated to the latest version"
}

function verify_texlive_package_manager() {
    # Just including texlua so the cache check above works
    # Needed for any use of texlua even if not testing LuaTeX
    info "TexLive: Checking for the installed luatex"
    if ! tlmgr_with_mirrors install luatex; then
        fail "TexLive: Failed to install luatex from every mirror"
    fi
    success "TexLive: Luatex was found"
}

function install_tex_dependency_packages() {
    # Installs the dependencies that we need
    # NOTE:
    #   - Other additional packages should be added to the block to avoid
    #     multiple calls to tlmgr
    #   - Package `ms` gives us `everyshi.sty`, which is a requirement. Sometime in
    # 2024, builds started breaking due to the ms package not being available. From
    # https://ctan.org/pkg/ms?lang=en, it appears to that this is due to the package
    # being split up, so this ms package is now replaced by everyshi (obsolete)
    #   - Package `collection-fontsrecommended` contains a lot of fonts,
    #     but we really just need `EU` and a few others
    #   - Package `fontawesome5` and the binary from apt are both required
    #
    # Changelog:
    # - 2026/10/30: Swapped from fontawesome (which pulled in 4.6.3.1 from 2016/05/15)
    #   to fontawesome7
    info "TexLive: Installing dependencies"
    if tlmgr_install_missing_packages \
        graphics                    \
        datetime2                   \
        datetime2-english           \
        tracklang                   \
        collection-fontsrecommended \
        xcolor                      \
        fontawesome7                \
        titlesec                    \
        textpos                     \
        everyshi                    \
        substr                      \
        isodate                     \
        fontspec                    \
        metalogo                    \
        xunicode                    \
        xltxtra                     \
        realscripts                 \
        etoolbox                    \
        xkeyval                     \
        datenumber                  \
        pdfescape                   \
        bookmark                    \
        letltxmacro                 \
        bitset                      \
        xetex \
        && verify_tex_files keyval.sty fontspec.sty metalogo.sty xunicode.sty ; then
        success "TexLive: All dependencies installed"
    else
        warn "TexLive: Failed to install dependencies, dumping out debug info"
        warn "TexLive: output of /tmp/texlive/texmf-var/web2c/tlmgr.log is:"
        cat /tmp/texlive/texmf-var/web2c/tlmgr.log

        # Additional debug if more detailed logging is required
        # warn "TexLive: Output of /tmp/texlive/texmf-var/web2c/tlmgr-commands.log is:"
        # cat /tmp/texlive/texmf-var/web2c/tlmgr-commands.log
        # warn "TexLive: Output of /tmp/texlive/texmf-var/web2c/xetex/xelatex.log is:"
        # cat /tmp/texlive/texmf-var/web2c/xetex/xelatex.log
        fail "TexLive: Failed to install dependencies, see above debug info"
    fi
}

function update_cache_manifest() {
  info "Updating cache manifest"
  tlmgr list --only-installed --data name,lcat-version > /tmp/texlive/package-manifest.txt
}

function install_imagemagick() {
    # Pinned so that a random ImageMagick update can't break the security
    # policy (which is version specific) or the build.
    #
    # [Version Bump] 2026 Oct 31: To 7.1.2-18, next version bump: on-or-after 2027 Apr 30
    local version="7.1.2-18"
    # Debian/Ubuntu package versions look like 8:7.1.2.18+dfsg1-1
    local apt_version="8:${version//-/.}*"

    info "Checking if imagemagick is installed"
    if ! command -v magick > /dev/null 2>&1; then
        info "Imagemagick was not found, installing version $version now"
        sudo apt-get update

        # GitHub-hosted runners exclude manpages by default; keep them so
        # ImageMagick's update-alternatives registrations have their target files.
        if ! sudo apt-get -o 'Dpkg::Options::=--path-include=/usr/share/man/*' install -y "imagemagick=${apt_version}" ; then
            fail "Failed to install imagemagick $version"
        fi
    fi

    # Previous to 2025-02-01, ubuntu-latest had imagemagick pre-installed,
    # it looks like it got removed sometime between Jan 01 and Feb 01 2025
    info "Imagemagick is installed, version and delegate info:"
    magick --version

    if ! magick --version | grep -q "ImageMagick ${version} "; then
        fail "Expected ImageMagick ${version}, update the pin (and review the security policy) if this is intentional"
    fi
}

start
