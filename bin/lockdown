#!/usr/bin/env bash

# Bash strict mode:
#   -e          exit immediately if any command fails
#   -u          treat unset variables as errors
#   -o pipefail a pipeline fails if any command in it fails, not just the last
set -euo pipefail

##
# Locks down the CI/CD environment's trust stores, so every later step makes
# appropriately secured network calls. This should run as early as possible.
#
# 2026 Oct: eMudhra (emSign) certificate private key breach
#
# eMudhra (emSign) root and intermediate certificates are no longer considered
# trustworthy after a private key breach. Details:
#   - Hacker News: https://news.ycombinator.com/item?id=50177916
#   - Mozilla incident: https://bugzilla.mozilla.org/show_bug.cgi?id=2083449&ref=scotthelme.co.uk
#   - Write-up: https://emudhra.we-have-a-problem.com/
#   - Site-wide runner policy: https://github.com/actions/runner-images/issues/15018
#
# When the set of distrusted CAs changes, update this script (not the workflow).
#
# Covers every trust store used in CI:
#   - The ubuntu runner system store (/etc/ssl/certs), which is used by
#     apt, curl, wget and therefore the TexLive package manager (tlmgr)
#   - The certifi bundles used by pip/python (requests), including the
#     copy vendored inside pip itself
#   - uv, which ships its own bundled roots unless told to use the system store
#
# Usage:
#   bin/lockdown [apply]         Removes the certificates
#   bin/lockdown verify          Fails if any store still trusts them
#   bin/lockdown env             Only exports the trust-store environment variables
#   bin/lockdown filter <bundle.pem>
#                                Rewrites a PEM bundle in place, minus distrusted certs
##

# shellcheck source=bin/utils.sh
source "$(dirname "$0")/utils.sh"

SYSTEM_BUNDLE="${SYSTEM_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
EMUDHRA_PATTERN='emudhra|emsign'

function is_distrusted() {
    local info
    info="$(printf '%s' "$1" | openssl x509 -noout -subject -issuer 2>/dev/null)" || return 1
    grep -qiE "${EMUDHRA_PATTERN}" <<< "${info}"
}

# Prints the PEM blocks of a bundle (stdin) that do NOT belong to eMudhra
function filter_bundle() {
    local block="" line
    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in
            *"BEGIN CERTIFICATE"*) block="${line}"$'\n' ;;
            *"END CERTIFICATE"*)
                block+="${line}"$'\n'
                if ! is_distrusted "${block}"; then
                    printf '%s' "${block}"
                fi
                block=""
                ;;
            *) [ -n "${block}" ] && block+="${line}"$'\n' ;;
        esac
    done
    return 0
}

function count_emudhra_certs() {
    local bundle="$1" block="" line count=0
    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in
            *"BEGIN CERTIFICATE"*) block="${line}"$'\n' ;;
            *"END CERTIFICATE"*)
                block+="${line}"$'\n'
                if is_distrusted "${block}"; then
                    count=$((count + 1))
                fi
                block=""
                ;;
            *) [ -n "${block}" ] && block+="${line}"$'\n' ;;
        esac
    done < "${bundle}"
    echo "${count}"
}

function python_bundles() {
    # certifi bundles in the project venv (pip/requests) and pip's vendored copy
    find "${VIRTUAL_ENV:-.venv}" . -maxdepth 8 -type f -name cacert.pem 2>/dev/null | sort -u || true
}

function filter_file() {
    local bundle="$1" tmp
    tmp="$(mktemp)"
    filter_bundle < "${bundle}" > "${tmp}"
    cat "${tmp}" > "${bundle}"
    rm -f "${tmp}"
}

function apply_system() {
    info "System: Distrusting eMudhra certificates"
    local conf=/etc/ca-certificates.conf cert
    if [ -d /usr/share/ca-certificates ] && [ -f "${conf}" ]; then
        while IFS= read -r cert; do
            cert="${cert#/usr/share/ca-certificates/}"
            sudo sed -i "s|^${cert}\$|!${cert}|" "${conf}"
        done < <(find /usr/share/ca-certificates -type f -iname '*emsign*' -o -type f -iname '*emudhra*')
        sudo update-ca-certificates --fresh > /dev/null
    fi
    success "System: eMudhra certificates are no longer trusted"
}

function apply_python() {
    local bundle
    while IFS= read -r bundle; do
        info "Python: Filtering ${bundle}"
        filter_file "${bundle}"
    done < <(python_bundles)
}

function export_env() {
    # Points pip, requests, uv (native TLS) and tlmgr (wget/curl/LWP) at the filtered system store
    local vars=(SSL_CERT_FILE="${SYSTEM_BUNDLE}" REQUESTS_CA_BUNDLE="${SYSTEM_BUNDLE}" PIP_CERT="${SYSTEM_BUNDLE}" CURL_CA_BUNDLE="${SYSTEM_BUNDLE}" UV_NATIVE_TLS=true)
    local v
    for v in "${vars[@]}"; do
        export "${v?}"
        [ -n "${GITHUB_ENV:-}" ] && echo "${v}" >> "${GITHUB_ENV}"
    done
    return 0
}

function verify() {
    local bundle remaining status=0
    for bundle in "${SYSTEM_BUNDLE}" $(python_bundles); do
        [ -f "${bundle}" ] || continue
        remaining="$(count_emudhra_certs "${bundle}")"
        if [ "${remaining}" -ne 0 ]; then
            warn "Verify: ${bundle} still trusts ${remaining} eMudhra certificate(s)"
            status=1
        else
            success "Verify: ${bundle} contains no eMudhra certificates"
        fi
    done
    return "${status}"
}

function start() {
    case "${1:-apply}" in
        apply) apply_system; apply_python; export_env; verify || fail "eMudhra certificates are still trusted" ;;
        env) export_env ;;
        verify) verify || fail "eMudhra certificates are still trusted" ;;
        filter) filter_file "${2:?bundle path required}" ;;
        *) fail "Unknown command: $1" ;;
    esac
}

start "$@"
