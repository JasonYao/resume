#!/usr/bin/env bash

set -e # Fails on the first error

##
# Generates a given pdf and thumbnail
# image from a tex file
##

# shellcheck source=bin/utils.sh
source "$(dirname "$0")/utils.sh"

base_file_name="Resume_Jason_Yao"
tex_file_name="${base_file_name}.tex"
dev_mode=false
florilegium_commit="5c9bd05ad7ad0ed7b0bfb0cfa2adc1720406e63b"
florilegium_source_dir="/tmp/florilegium-${florilegium_commit}"

build_mode="${1:-default}"
case "${build_mode}" in
    default)
        output_file_name="${base_file_name}"
        latex_options=""
        ;;
    dev)
        output_file_name="${base_file_name}"
        latex_options=""
        dev_mode=true
        ;;
    *)
        fail "Usage: $0 [dev]"
        ;;
esac

function start() {
    generate_outputs

    generate_florilegium_layer

    generate_pdf "${tex_file_name}"

    # We use the absolute path here because
    # imagemagick 6 throws exceptions with a
    # relative path
    generate_thumbnail "$(pwd)/${output_file_name}"

    if [[ "${dev_mode}" == true ]]; then
        generate_layer_previews
    fi
}

function generate_florilegium_layer() {
    local source file checksum destination
    local -a sources=(
        "LICENSE 678586fc6cb4e118639751cf9a9c816731a05ddc03b7a4ba2e51f28c314edbe3"
        "authored.lua d8bf84b8e3de5421d164bc9358e9049d2de4065c1563564304a3304e5e1665ca"
        "flora.lua 44605dbc87579cca3c2c3c499a992e2dac0f0c420147c0e0d37c9758688472d9"
        "florilegium.lua 62b7c5455c864ff001227facf48244723d22c6964098054d39d76db4d177ae04"
        "florilegium.sty 7f1eda0d14d92a2e5dca9c2d23329970a850c738b4647524c7d672c549441e91"
        "grow.lua 8c1b12a89eeff22f0a75ee26fb36eb1336c36881e563e8284e190eab1d50c230"
        "ink.lua 697dc474e9cf64eb0e7d884b3a72d9abfb5b0599ec21c7ced1599850f9766f31"
    )

    mkdir -p "${florilegium_source_dir}"
    for source in "${sources[@]}"; do
        read -r file checksum <<< "${source}"
        destination="${florilegium_source_dir}/${file}"
        if [[ -f "${destination}" ]] && printf '%s  %s\n' "${checksum}" "${destination}" | sha256sum --check --status; then
            continue
        fi

        info "Downloading pinned Florilegium source: ${file}"
        if ! curl --fail --location --silent --show-error \
            "https://raw.githubusercontent.com/kevinraymond/florilegium/${florilegium_commit}/${file}" \
            --output "${destination}.tmp"; then
            rm -f "${destination}.tmp"
            fail "Failed to download Florilegium source: ${file}"
        fi
        if ! printf '%s  %s\n' "${checksum}" "${destination}.tmp" | sha256sum --check --status; then
            rm -f "${destination}.tmp"
            fail "Florilegium source checksum mismatch: ${file}"
        fi
        mv "${destination}.tmp" "${destination}"
    done

    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH
    export TEXINPUTS="${florilegium_source_dir}//:${TEXINPUTS:-}"
    export LUAINPUTS="${florilegium_source_dir}//:${LUAINPUTS:-}"

    info "Generating Florilegium garden layer"
    if lualatex -interaction=nonstopmode -halt-on-error -jobname=florilegium_layer florilegium_layer.tex; then
        success "Generated Florilegium garden layer"
    else
        fail "Failed to generate Florilegium garden layer"
    fi
}

function generate_outputs() {
    info "Generating output formats"
    if uv run python main.py ; then
      success "Successfully generated output formats"
    else
      fail "Failed to generate output formats"
    fi
}

function generate_pdf() {
    input_file_name=$1
    # We generate the image 3 times to let it stabilize
    for count in {1..3}
    do
        generate_pdf_once "${count}" "${input_file_name}"
    done
}

function generate_pdf_once() {
    count=$1
    input_tex_file_name=$2

    # Other scripts apparently don't export PATHs correctly between github action steps
    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH

    info "Build ${count}: Generating resume document now"
    if xelatex -jobname="${output_file_name}" "${latex_options}\\input{${input_tex_file_name}}" ; then
        success "Build ${count}: Generated the new resume document"
    else
        fail "Build ${count}: Failed to generate the new resume document"
    fi
}

function generate_thumbnail() {
    # Generates the image thumbnail for a given pdf
    absolute_base_file_name=$1
    info "Thumbnail Build: Generating image thumbnail now"

    if magick -density 300 "${absolute_base_file_name}.pdf[0]" -flatten "${absolute_base_file_name}.png" ; then
        success "Thumbnail Build: Generated the new image thumbnail"
    else
        fail "Thumbnail Build: Failed to generate the new image thumbnail"
    fi
}

function generate_layer_previews() {
    local layer_names=(background header columns foreground)
    local index
    local layer_name
    local layer_base_file_name
    local layer_tex_file
    local layer_options

    for index in "${!layer_names[@]}"; do
        layer_name="${layer_names[$index]}"
        layer_base_file_name="${base_file_name}_layer_$((index + 1))_${layer_name}"
        layer_tex_file="/tmp/${base_file_name}_${layer_name}_preview.tex"
        awk -v layer="${layer_name}" '{ print; if (index($0, "\\documentclass") == 1) printf "\\renewcommand{\\resumeLayerPreview}{%s}\n", layer }' "${tex_file_name}" > "${layer_tex_file}"
        layer_options="${latex_options}\\input{${layer_tex_file}}"

        info "Build: Generating ${layer_name} layer preview"
        export PATH=/tmp/texlive/bin/x86_64-linux:$PATH
        for count in {1..3}; do
            if ! xelatex -interaction=nonstopmode -halt-on-error -jobname="${layer_base_file_name}" "${layer_options}" ; then
                fail "Build: Failed to generate ${layer_name} layer preview"
            fi
        done

        if ! magick -density 300 "${layer_base_file_name}.pdf[0]" -flatten "${layer_base_file_name}.png" ; then
            fail "Build: Failed to generate ${layer_name} layer PNG"
        fi
        rm -f "${layer_base_file_name}.pdf"
        success "Build: Generated ${layer_base_file_name}.png"
    done
}

start
