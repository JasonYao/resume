#!/usr/bin/env bash

set -e # Fails on the first error

##
# Generates a given pdf and thumbnail
# image from a tex file
##

# shellcheck source=bin/utils.sh
source "$(dirname "$0")/utils.sh"

base_file_name="Resume_Jason_Yao"
tex_file_name="${base_file_name}.tex"
dev_mode=false

# The flowers are still being tuned, so the final output is built without them. Set this to true to
# bring them back into the final output (dev builds always also produce a flowers-enabled version)
final_flowers_enabled=true
flowers_option="\\def\\resumeEnableFlowers{}"
flowers_file_name="${base_file_name}_flowers"
florilegium_source_dir="$(dirname "${BASH_SOURCE[0]}")/../vendors/florilegium"

# With no argument, only builds from the source branch (and local builds, which have no GITHUB_REF)
# produce the default build, every other CI ref gets the dev build with the layer previews
build_mode="${1:-auto}"
if [[ "${build_mode}" == "auto" ]]; then
    if [[ -z "${GITHUB_REF:-}" || "${GITHUB_REF}" == "refs/heads/source" ]]; then
        build_mode="default"
    else
        build_mode="dev"
    fi
fi

case "${build_mode}" in
    default)
        ;;
    dev)
        dev_mode=true
        ;;
    *)
        fail "Usage: $0 [default|dev]"
        ;;
esac

function start() {
    local final_latex_options=""
    if [[ "${final_flowers_enabled}" == true ]]; then
        final_latex_options="${flowers_option}"
    fi

    generate_outputs

    if [[ "${final_flowers_enabled}" == true || "${dev_mode}" == true ]]; then
        # Complete all TeX passes so text bounds are available to pdftotext
        generate_pdf "${tex_file_name}" "${base_file_name}_measure" ""
        generate_flower_masks "${base_file_name}_measure.pdf"
        generate_florilegium_layer
    fi

    # The actual final output
    generate_pdf "${tex_file_name}" "${base_file_name}" "${final_latex_options}"

    # We use the absolute path here because
    # imagemagick 6 throws exceptions with a
    # relative path
    generate_thumbnail "$(pwd)/${base_file_name}"

    if [[ "${dev_mode}" == true ]]; then
        # Previews with the flowers enabled, regardless of the final output
        generate_pdf "${tex_file_name}" "${flowers_file_name}" "${flowers_option}"
        generate_thumbnail "$(pwd)/${flowers_file_name}"
        generate_layer_previews
    fi
}

function generate_florilegium_layer() {
    if [[ ! -f "${florilegium_source_dir}/florilegium.sty" ]]; then
        fail "Florilegium is missing, run bin/fetch_florilegium to pull it in first"
    fi
    florilegium_source_dir="$(cd "${florilegium_source_dir}" && pwd)"

    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH
    export TEXINPUTS="${florilegium_source_dir}//:${TEXINPUTS:-}"
    export LUAINPUTS="${florilegium_source_dir}//:${LUAINPUTS:-}"

    florilegium_seed="$(date +%s%N | cksum | cut -d ' ' -f 1)"
    info "Generating Florilegium garden layer with seed ${florilegium_seed}"
    if lualatex -interaction=nonstopmode -halt-on-error -jobname=florilegium_layer \
        "\\def\\florilegiumseed{${florilegium_seed}}\\input{florilegium_layer.tex}"; then
        success "Generated Florilegium garden layer with seed ${florilegium_seed}"
    else
        fail "Failed to generate Florilegium garden layer"
    fi
}

function generate_flower_masks() {
    info "Measuring resume text regions for flower masks"
    if uv run python -m pyresume.flower_masks "$1"; then
        success "Measured resume text regions for flower masks"
    else
        fail "Failed to measure resume text regions for flower masks"
    fi
}

function generate_outputs() {
    info "Generating output formats"
    if uv run python main.py ; then
      success "Successfully generated output formats"
    else
      fail "Failed to generate output formats"
    fi
}

function generate_pdf() {
    local input_file_name=$1
    local output_file_name=$2
    local latex_options=$3
    local count
    # We generate the image 3 times to let it stabilize
    for count in {1..3}
    do
        generate_pdf_once "${count}" "${input_file_name}" "${output_file_name}" "${latex_options}"
    done
}

function generate_pdf_once() {
    local count=$1
    local input_tex_file_name=$2
    local output_file_name=$3
    local latex_options=$4

    # Other scripts apparently don't export PATHs correctly between github action steps
    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH

    info "Build ${count}: Generating resume document now"
    if xelatex -jobname="${output_file_name}" "${latex_options}\\input{${input_tex_file_name}}" ; then
        success "Build ${count}: Generated the new resume document"
    else
        fail "Build ${count}: Failed to generate the new resume document"
    fi
}

function generate_thumbnail() {
    # Generates the image thumbnail for a given pdf
    local absolute_base_file_name=$1
    info "Thumbnail Build: Generating image thumbnail now"

    if magick -density 300 "${absolute_base_file_name}.pdf[0]" -flatten "${absolute_base_file_name}.png" ; then
        success "Thumbnail Build: Generated the new image thumbnail"
    else
        fail "Thumbnail Build: Failed to generate the new image thumbnail"
    fi
}

function generate_layer_previews() {
    generate_layer 1 background
    generate_layer 2 flowers
    generate_layer 3 top-section-and-totoro
    generate_layer 4 columns
    generate_layer 5 foreground
}

# Generates the standalone pdf-derived png of a single resume layer
function generate_layer() {
    local index=$1
    local layer_name=$2
    local layer_base_file_name="${base_file_name}_layer_${index}_${layer_name}"
    local layer_tex_file="/tmp/${base_file_name}_${layer_name}_preview.tex"
    local layer_options

    awk -v layer="${layer_name}" '{ print; if (index($0, "\\documentclass") == 1) printf "\\renewcommand{\\resumeLayerPreview}{%s}\n", layer }' "${tex_file_name}" > "${layer_tex_file}"
    layer_options="${flowers_option}\\input{${layer_tex_file}}"

    info "Build: Generating ${layer_name} layer preview"
    export PATH=/tmp/texlive/bin/x86_64-linux:$PATH
    for count in {1..3}; do
        if ! xelatex -interaction=nonstopmode -halt-on-error -jobname="${layer_base_file_name}" "${layer_options}" ; then
            fail "Build: Failed to generate ${layer_name} layer preview"
        fi
    done

    if [[ "${layer_name}" == flowers ]]; then
        if ! magick -density 300 -background none "${layer_base_file_name}.pdf[0]" "${layer_base_file_name}.png" ; then
            fail "Build: Failed to generate ${layer_name} layer PNG"
        fi
    elif ! magick -density 300 "${layer_base_file_name}.pdf[0]" -flatten "${layer_base_file_name}.png" ; then
        fail "Build: Failed to generate ${layer_name} layer PNG"
    fi
    rm -f "${layer_base_file_name}.pdf"
    success "Build: Generated ${layer_base_file_name}.png"
}

start
