#!/usr/bin/env bash

set -euo pipefail

echo "Looking up the open pull request for ${GITHUB_REF_NAME}."
pulls="$(curl --silent --show-error --fail-with-body \
    --oauth2-bearer "${GITHUB_TOKEN}" \
    --header "Accept: application/vnd.github+json" \
    --get \
    --data-urlencode "state=open" \
    --data-urlencode "head=${GITHUB_REPOSITORY_OWNER}:${GITHUB_REF_NAME}" \
    --data-urlencode "per_page=100" \
    "${GITHUB_API_URL}/repos/${GITHUB_REPOSITORY}/pulls")"
pull_number="$(jq -r \
    --arg ref "${GITHUB_REF_NAME}" \
    --arg repository "${GITHUB_REPOSITORY}" \
    '[.[] | select(.head.ref == $ref and .head.repo != null and .head.repo.full_name == $repository)][0].number // empty' \
    <<< "${pulls}")"

if [[ -z "${pull_number}" ]]; then
    echo "No open pull request found for ${GITHUB_REF_NAME}; skipping preview comment."
    exit 0
fi

artifact_url="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/artifacts"
comment_body="$(printf '<!-- resume-preview -->\n[Download the generated resume PDF and PNG](%s)' "${artifact_url}")"
comment_payload="$(jq -n --arg body "${comment_body}" '{body: $body}')"
echo "Looking up the existing preview comment on pull request #${pull_number}."
comments="$(curl --silent --show-error --fail-with-body \
    --oauth2-bearer "${GITHUB_TOKEN}" \
    --header "Accept: application/vnd.github+json" \
    "${GITHUB_API_URL}/repos/${GITHUB_REPOSITORY}/issues/${pull_number}/comments?per_page=100")"
comment_id="$(jq -r \
    '[.[] | select(.user.login == "github-actions[bot]" and ((.body // "") | contains("<!-- resume-preview -->")))][0].id // empty' \
    <<< "${comments}")"

if [[ -n "${comment_id}" ]]; then
    echo "Updating preview comment #${comment_id} on pull request #${pull_number}."
    curl --silent --show-error --fail-with-body \
        --request PATCH \
        --oauth2-bearer "${GITHUB_TOKEN}" \
        --header "Accept: application/vnd.github+json" \
        --header "Content-Type: application/json" \
        --data "${comment_payload}" \
        "${GITHUB_API_URL}/repos/${GITHUB_REPOSITORY}/issues/comments/${comment_id}" > /dev/null
else
    echo "Creating preview comment on pull request #${pull_number}."
    curl --silent --show-error --fail-with-body \
        --request POST \
        --oauth2-bearer "${GITHUB_TOKEN}" \
        --header "Accept: application/vnd.github+json" \
        --header "Content-Type: application/json" \
        --data "${comment_payload}" \
        "${GITHUB_API_URL}/repos/${GITHUB_REPOSITORY}/issues/${pull_number}/comments" > /dev/null
fi
